{
  "name": "sse-devtools-panel",
  "version": "1.2.2",
  "private": true,
  "license": "MIT",
  "homepage": "https://fatmii.github.io/sse-devtools-panel/",
  "description": "Chrome DevTools panel for debugging SSE / NDJSON / Connect+JSON streaming responses",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node demo/server.mjs",
    "release:zip": "node scripts/package-release.mjs",
    "website:dev": "node scripts/sync-website-screenshots.mjs && pnpm --dir website dev",
    "website:build": "pnpm build && pnpm release:zip && node scripts/build-website.mjs",
    "website:preview": "pnpm --dir website preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.287",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
