---
import type { Locale } from "../i18n";
import { getTranslations, screenshotUrl } from "../i18n";
import SkeletonImage from "./SkeletonImage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const src = screenshotUrl("panel-overview.gif", import.meta.env.BASE_URL);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="maintained-badge">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>{t.hero.maintained}</span>
    </p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="actions">
      <a class="button primary" href="#install">{t.nav.install}</a>
      <a class="button" href="#demo">{t.hero.ctaDemo}</a>
    </div>
    <ul class="proof" aria-label={t.hero.proofLabel}>
      <li><strong>MIT</strong> {t.hero.proofOpenSource}</li>
      <li><strong>{locale === "zh" ? "本地" : "Local"}</strong> {t.hero.proofLocal}</li>
      <li><strong>MV3</strong> {t.hero.proofExtension}</li>
      <li><a href="#whats-new">{t.nav.whatsNew}</a></li>
    </ul>
  </div>

  <div class="hero-visual" id="demo" aria-label={t.heroDemo.ariaLabel}>
    <div class="browser-frame">
      <div class="window-chrome">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="window-url">{t.heroDemo.windowUrl}</div>
        <div class="window-badge">LIVE</div>
      </div>
      <SkeletonImage
        class="hero-demo-media"
        src={src}
        alt={t.heroDemo.imageAlt}
        width={1400}
        height={788}
        loading="eager"
        zoomable
      />
    </div>
  </div>
</section>
