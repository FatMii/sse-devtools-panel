---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  /** Defer network fetch until near viewport (stronger than loading=lazy). */
  defer?: boolean;
  zoomable?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto",
  defer = false,
  zoomable = false,
} = Astro.props;
---

<div
  class:list={["skeleton-media", { "is-deferred": defer }]}
  style={`aspect-ratio: ${width} / ${height}`}
  data-defer={defer ? "1" : undefined}
>
  <div class="loading-skeleton skeleton-media-shimmer" aria-hidden="true"></div>
  <img
    class:list={["skeleton-media-img", className]}
    src={defer ? undefined : src}
    data-src={defer ? src : undefined}
    alt={alt}
    width={width}
    height={height}
    loading={defer ? "lazy" : loading}
    fetchpriority={fetchpriority === "auto" ? undefined : fetchpriority}
    decoding="async"
    data-zoomable={zoomable ? true : undefined}
  />
</div>
