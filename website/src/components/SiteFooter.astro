---
import type { Locale } from "../i18n";
import { assetUrl, docsUrl, getTranslations } from "../i18n";
import { compliance, site } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const base = import.meta.env.BASE_URL;
const privacyHref = assetUrl(locale === "zh" ? "privacy/" : "en/privacy/", base);
const icpNumber: string = compliance.icpNumber;
const psbNumber: string = compliance.psbNumber;
const filings = [
  icpNumber ? { label: icpNumber, href: compliance.icpUrl } : null,
  psbNumber ? { label: psbNumber, href: compliance.psbUrl } : null,
].filter((item) => item !== null);
---

<footer class="site-footer">
  <p>
    <span>{site.name}</span>
    <span>MIT</span>
    <a href={docsUrl(locale)} target="_blank" rel="noreferrer">{t.footer.readme}</a>
    <a href={site.urls.changelog} target="_blank" rel="noreferrer">{t.footer.changelog}</a>
    <a href={site.urls.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={privacyHref}>{t.footer.privacy}</a>
  </p>
  <p class="footer-legal">{t.footer.personal}</p>
  {
    filings.length > 0 && (
      <p class="footer-icp">
        {filings.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label}
          </a>
        ))}
      </p>
    )
  }
</footer>
