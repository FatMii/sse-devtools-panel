---
import type { Locale } from "../i18n";
import { getTranslations, screenshotUrl } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const src = screenshotUrl("panel-overview.gif", import.meta.env.BASE_URL);
---

<section class="hero-demo" aria-label={t.heroDemo.ariaLabel}>
  <div class="hero-demo-wrap">
    <div class="browser-frame">
      <div class="window-chrome">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="window-url">{t.heroDemo.windowUrl}</div>
        <div class="window-badge">LIVE</div>
      </div>
      <img
        class="hero-demo-media"
        src={src}
        alt={t.heroDemo.imageAlt}
        width="1400"
        height="788"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
