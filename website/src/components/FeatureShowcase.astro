---
import type { Locale } from "../i18n";
import { getTranslations, screenshotUrl } from "../i18n";
import SkeletonImage from "./SkeletonImage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="feature-showcase" id="features" aria-labelledby="features-title">
  <div class="feature-showcase-head">
    <h2 id="features-title">{t.features.title}</h2>
    <p>{t.features.subtitle}</p>
  </div>
  <ol class="feature-grid">
    {
      t.features.items.map((item, index) => (
        <li class:list={["feature-card", { "feature-card--lead": index === 0 }]}>
          <div class="feature-media">
            <SkeletonImage
              src={screenshotUrl(item.image, import.meta.env.BASE_URL)}
              alt={item.alt}
              width={1200}
              height={675}
              zoomable
            />
          </div>
          <div class="feature-copy">
            <span class="feature-num">{item.num}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tag-list" aria-label={t.features.tagsAria(item.title)}>
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
