---
import { screenshotUrl } from "../i18n";
import SkeletonImage from "./SkeletonImage.astro";
import DemoClip from "./DemoClip.astro";

interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  tags: readonly string[];
  tagsAria: string;
  reverse?: boolean;
}

const { title, description, image, alt, tags, tagsAria } = Astro.props;
const src = screenshotUrl(image, import.meta.env.BASE_URL);
const gifStem = image.replace(/\.gif$/i, "");
const isGif = /\.gif$/i.test(image);
---

<article class="spotlight">
  <div class="spotlight-media">
    {
      isGif ? (
        <DemoClip stem={gifStem} alt={alt} width={1400} height={788} defer />
      ) : (
        <SkeletonImage
          src={src}
          alt={alt}
          width={1400}
          height={788}
          fetchpriority="low"
          zoomable
        />
      )
    }
  </div>
  <div class="spotlight-copy">
    <ul class="tag-list" aria-label={tagsAria}>
      {tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>
