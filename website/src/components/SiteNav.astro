---
import { site } from "../data/site";
---

<nav class="site-nav">
  <a class="brand" href={import.meta.env.BASE_URL}>
    <span class="brand-mark">SSE</span>
    <span class="brand-name">{site.name}</span>
  </a>
  <div class="nav-actions">
    <a href={site.urls.github} target="_blank" rel="noreferrer">GitHub</a>
    <button class="theme-toggle" type="button" id="theme-toggle">夜间</button>
    <a class="install-mini" href="#install">获取扩展</a>
  </div>
</nav>
