---
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";
import { site } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const zipName = `sse-devtools-panel-v${site.version}.zip`;
const offlineZip = site.offlineZipPath(site.version, import.meta.env.BASE_URL);
---

<section class="install-section" id="install">
  <div class="install-head">
    <h2>{t.install.title}</h2>
    <p>{t.install.subtitle}</p>
  </div>

  <div class="install-paths">
    <article class="install-path">
      <h3>{t.install.storeTitle}</h3>
      <p>{t.install.storeBody}</p>
      <a class="button primary" href={site.urls.chromeStore} target="_blank" rel="noreferrer">
        {t.install.storeCta}
      </a>
    </article>

    <article class="install-path recommended" id="install-offline">
      <h3>
        {t.install.offlineTitle}
        <span class="path-badge">{t.install.offlineBadge}</span>
      </h3>
      <p set:html={t.install.offlineBody} />
      <a class="button primary" href={offlineZip} download={zipName}>
        {t.install.offlineCta(site.version)}
      </a>
    </article>
  </div>

  <p class="install-foot">
    {t.install.footPrefix}
    <a href={site.urls.githubReleases} target="_blank" rel="noreferrer">{t.install.footReleases}</a>
    {t.install.footSuffix}
  </p>
</section>
